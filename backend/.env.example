MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
PORT=3001

# Authentication — required. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime (any value accepted by `jsonwebtoken`, e.g. 7d, 12h).
TOKEN_TTL=7d
# Default admin account created automatically on first run if it does not exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Origin(s) allowed to call this API (the deployed frontend). Comma-separate several.
FRONTEND_URL=https://mern-qfdv.vercel.app

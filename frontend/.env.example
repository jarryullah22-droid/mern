# VITE_API_URL: Base URL of the backend API (no trailing slash).
# Production (deployed Express API on Vercel):
VITE_API_URL=https://pro-with-next-vmxq.vercel.app
# Local dev — leave the value below and rely on the Vite proxy in vite.config.ts,
# or point it at your local API, e.g. http://localhost:3001

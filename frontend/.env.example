# VITE_API_URL: Base URL of the backend API (no trailing slash).
# Production — the deployed Express API on Vercel:
VITE_API_URL=https://mern-kappa-liart.vercel.app
# Local dev — set this to your local API (http://localhost:3001), or leave it
# empty to fall back to the Vite proxy in vite.config.ts.
# VITE_API_URL=http://localhost:3001
